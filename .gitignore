.env
test-results/
# T-1602b · Per-run flake reports (packages/ui/flake-results/run-<i>.json). A
# sibling of test-results/ rather than a child, because Playwright erases its
# outputDir at the start of every run — see packages/ui/e2e/support/flake-io.ts.
flake-results/
playwright-report/
.DS_Store
node_modules/
dist/
dist-web/
.vite/
# T-1701b · Packaging output. `renderer/` is a staged COPY of packages/ui/dist-web
# (scripts/copy-renderer.mjs) and `release/` is electron-builder's output — both
# are build artifacts of committed sources, so committing either would only
# create a second, staler copy of the cockpit.
packages/desktop/renderer/
packages/desktop/release/
*.tsbuildinfo
.scratch/
