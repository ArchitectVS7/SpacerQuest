{
  "name": "@spacerquest/desktop",
  "version": "0.5.2",
  "private": true,
  "description": "T-1701a/b/T-1702a \u00b7 Electron shell: window management, OS app-data saves, packaging, an inert updater stub and the Steamworks achievement mirror. Zero game rules.",
  "author": "Rimward",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run build && electron dist/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:packaged": "playwright test --config playwright.packaged.config.ts",
    "package:renderer": "node scripts/copy-renderer.mjs",
    "package:mac": "node scripts/copy-renderer.mjs && electron-builder --mac --publish never",
    "package:win": "node scripts/copy-renderer.mjs && electron-builder --win --publish never",
    "package:mac:demo": "node scripts/copy-renderer.mjs --edition demo && electron-builder --mac --config electron-builder.demo.cjs --publish never && node scripts/check-size.mjs",
    "package:win:demo": "node scripts/copy-renderer.mjs --edition demo && electron-builder --win --config electron-builder.demo.cjs --publish never && node scripts/check-size.mjs"
  },
  "build": {
    "appId": "com.spacerquest.rimward",
    "productName": "Rimward",
    "extraMetadata": {
      "name": "rimward"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json",
      "node_modules/steamworks.js/**"
    ],
    "asarUnpack": [
      "**/node_modules/steamworks.js/**"
    ],
    "electronVersion": "43.2.0",
    "npmRebuild": false,
    "publish": null,
    "mac": {
      "target": [
        "dir",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "dir",
        "nsis"
      ]
    }
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vitest": "^1.5.0"
  }
}
