{
  // T-1701a · The Electron shell's Playwright suite. `noEmit` — these are specs,
  // not build output — but `composite` so the root solution build can reference
  // them, which is how `npx tsc -b` covers e2e (the gate requires it).
  //
  // `NodeNext` rather than the web suite's `Bundler`: this code runs in NODE,
  // not in a page. It spawns the real `dist/main.js`, so it needs `__dirname`
  // semantics and node module resolution. `lib` still carries DOM because
  // `page.evaluate` bodies are type-checked against the browser.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["**/*.ts", "../playwright.config.ts", "../playwright.packaged.config.ts"]
}
