{
  "name": "@spacerquest/ui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @spacerquest/engine -- --force",
    "dev": "vite",
    "prebuild": "npm run build -w @spacerquest/engine -- --force",
    "build": "vite build",
    "prebuild:demo": "npm run build -w @spacerquest/engine -- --force",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --port 5173",
    "preview:demo": "vite preview --mode demo --port 5174",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "flake:measure": "tsx e2e/support/flake-measure.ts",
    "flake:report": "tsx e2e/support/flake-cli.ts"
  },
  "dependencies": {
    "@spacerquest/content": "*",
    "@spacerquest/engine": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^1.5.0"
  }
}
