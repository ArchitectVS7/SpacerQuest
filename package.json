{
  "name": "spacerquest-rimward",
  "version": "0.5.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "sim": "npm run sim -w @spacerquest/sim --",
    "balance:sweep": "npm run balance:sweep -w @spacerquest/sim --",
    "balance:diff": "npm run balance:diff -w @spacerquest/sim --",
    "balance:report": "npm run balance:report -w @spacerquest/sim --",
    "balance:extract": "npm run balance:extract -w @spacerquest/sim --",
    "balance:smoke": "npm run balance:smoke -w @spacerquest/sim",
    "dev:panel": "npm run dev:panel -w @spacerquest/devpanel --",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:mac": "npm run build -w @spacerquest/ui && npx tsc -b && npm run package:mac -w @spacerquest/desktop",
    "package:win": "npm run build -w @spacerquest/ui && npx tsc -b && npm run package:win -w @spacerquest/desktop",
    "package:mac:demo": "npm run build:demo -w @spacerquest/ui && npx tsc -b && npm run package:mac:demo -w @spacerquest/desktop",
    "package:win:demo": "npm run build:demo -w @spacerquest/ui && npx tsc -b && npm run package:win:demo -w @spacerquest/desktop",
    "release:verify": "node scripts/verify-clean-clone.mjs",
    "release:signoff": "node scripts/check-signoff.mjs",
    "release:rc": "node scripts/tag-rc.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
